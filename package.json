{
  "name": "margin-workspace",
  "version": "1.2.1",
  "description": "A private, self-hosted workspace for reviewing Markdown documents together. Browse project folders, read formatted Markdown, select passages, discuss them in threads, and export agent-readable feedback to the source project.",
